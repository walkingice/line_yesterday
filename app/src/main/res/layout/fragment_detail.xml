<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/detail_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/detail_image"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:contentDescription="@string/detail_image"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadline5" />

            <TextView
                android:id="@+id/detail_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/detail_extra_information"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp" />
        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/detail_favorite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:contentDescription="@string/detail_add_favorite"
        android:src="@android:drawable/btn_star_big_off"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/detail_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/detail_error_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/detail_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail_error_content" />

        <Button
            android:id="@+id/detail_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail_retry"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/detail_refresh_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:background="@color/black"
        android:padding="8dp"
        android:text="@string/detail_error_content"
        android:textColor="@color/white"
        android:visibility="gone" />

    <TextView
        android:id="@+id/screen_name"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:contentDescription="@string/detail_screen_name" />
</FrameLayout>
